{
  "name": "dispatch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "dev:migrate": "wrangler d1 migrations apply dispatch-db --local",
    "site:dev": "astro dev --root site",
    "site:build": "astro build --root site",
    "beta:deploy": "wrangler deploy --env beta",
    "beta:migrate": "wrangler d1 migrations apply dispatch-db-beta --remote --env beta",
    "beta:register": "tsx --env-file=.dev.vars src/register.ts",
    "prod:deploy": "wrangler deploy",
    "prod:migrate": "wrangler d1 migrations apply dispatch-db --remote",
    "prod:register": "tsx --env-file=.env src/register.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^26.1.1",
    "astro": "^7.4.4",
    "discord-api-types": "^0.38.57",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.5.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.113.0"
  },
  "dependencies": {
    "discord-hono": "^0.22.2",
    "hono": "^4.13.14"
  }
}
