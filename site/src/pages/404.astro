---
import Base from '../layouts/Base.astro';
---

<Base
  title="Page not found — Dispatch"
  description="This page doesn't exist."
  path="/404/"
  noindex
>
  <main class="nf">
    <div class="hero-bg">
      <div class="wrap page-head">
        <span class="index">Error</span>
        <h1>Page not <em>found.</em></h1>
        <p class="lede">
          That link doesn't lead anywhere. It may have moved, or the address was mistyped. Head back to the homepage, or
          check the docs to see what Dispatch can do.
        </p>
        <div class="cta">
          <a class="button large" href="/">Back to home <svg class="arrow" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h18" /><path d="M15.5 6.5 21 12l-5.5 5.5" /></svg></a>
          <a class="button large ghost" href="/docs/">Read the docs</a>
        </div>
        <p class="assure">
          Still stuck? <a href="https://github.com/dispatch-hq/dispatch/issues" target="_blank" rel="noopener noreferrer">Report a problem ↗</a>
        </p>
      </div>
    </div>
  </main>
</Base>
