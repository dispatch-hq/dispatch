---
import Base from '../layouts/Base.astro';

const rounds = 10;

const reasons = [
  [
    'No server to go down',
    'Dispatch is a Cloudflare Worker, not a process on a machine. There is no host to reboot, patch or run out of memory. Each request runs in a fresh, isolated sandbox, and a crash in one never touches the next.',
  ],
  [
    'Discord comes to us',
    'Most bots hold a gateway connection open all day and have to reconnect when it drops. Dispatch has none. Discord sends each command to an HTTPS endpoint, so there is nothing to reconnect and nothing to miss while we deploy.',
  ],
  [
    'Close to every server',
    'Cloudflare runs the Worker in hundreds of cities and answers each request from the nearest one. A traffic spike is spread across the network instead of piling onto one box.',
  ],
  [
    'Answers inside three seconds',
    'Discord gives a bot three seconds to respond. Anything that touches the database or another API replies right away with “thinking…” and finishes in the background, so a slow query never turns into a failed command.',
  ],
  [
    'Durable by default',
    'Reports live in Cloudflare D1, which keeps storage durable and backed up, with point-in-time restore. Attachments are rehosted in R2, so a report still has its screenshots after the original Discord message is deleted.',
  ],
  [
    'Shipped in small steps',
    'Every change goes through typechecking and an end-to-end test suite that runs real signed interactions through the Worker before it merges. Deploys swap in a new version without a restart.',
  ],
];
---

<Base
  title="Status — Dispatch"
  description="Live status for Dispatch: test your ping, see servers and members served, dependency health, and how running on Cloudflare Workers keeps the bot available."
  path="/status/"
  ogImage="/og-status.png"
  imageAlt="Dispatch status: live ping, servers and how the bot stays online."
>
  <main>
    <div class="hero-bg">
      <div class="wrap page-head">
        <span class="index">Status</span>
        <h1>Always on, <em>by design.</em></h1>
        <p class="lede">
          Numbers from the running bot, a ping test to try for yourself, and the reasons it stays up.
        </p>
      </div>
    </div>

    <section class="status-section">
      <div class="wrap">
        <div class="status-banner" id="banner" data-state="loading" role="status" aria-live="polite">
          <span class="dot" aria-hidden="true"></span>
          <b id="banner-text">Checking…</b>
          <span id="banner-note">Contacting the bot</span>
        </div>

        <div class="cells three status-grid">
          <div class="cell stat ping-cell">
            <span class="num">Ping test</span>
            <p class="stat-value"><b id="ping">—</b><span>ms</span></p>
            <svg class="graph" viewBox="0 0 120 56" preserveAspectRatio="none" aria-hidden="true">
              <line x1="0" y1="55.5" x2="120" y2="55.5" stroke="var(--border)" stroke-width="1" vector-effect="non-scaling-stroke"></line>
              <polyline id="graph-line" points="" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"></polyline>
            </svg>
            <p class="ping-rank" id="ping-rank" hidden></p>
            <p class="stat-note" id="ping-note" aria-live="polite">
              {`${rounds} quick pings from your browser to the nearest edge. How fast are you?`}
            </p>
            <button class="button small" type="button" id="ping-run">Check ping</button>
          </div>

          <div class="cell stat">
            <span class="num">Servers</span>
            <p class="stat-value"><b id="servers">—</b></p>
            <p class="stat-note">Discord servers with Dispatch installed.</p>
          </div>

          <div class="cell stat">
            <span class="num">Members watched over</span>
            <p class="stat-value"><b id="members">—</b></p>
            <p class="stat-note">Across those servers. Someone in two servers counts twice.</p>
          </div>
        </div>

        <div class="cells three status-grid checks">
          <div class="cell stat">
            <span class="num">Worker</span>
            <p class="stat-state" id="worker-state">—</p>
            <p class="stat-note" id="worker-note">Answering from <span id="colo">the nearest edge</span>.</p>
          </div>
          <div class="cell stat">
            <span class="num">Database</span>
            <p class="stat-state" id="db-state">—</p>
            <p class="stat-note" id="db-note">Cloudflare D1 round trip.</p>
          </div>
          <div class="cell stat">
            <span class="num">Discord API</span>
            <p class="stat-state" id="discord-state">—</p>
            <p class="stat-note" id="discord-note">Time to read the server list.</p>
          </div>
        </div>

        <p class="command-note" id="updated">Checking…</p>
      </div>
    </section>

    <section id="why">
      <div class="wrap">
        <div class="section-head">
          <span class="index">01 — How it stays up</span>
          <h2>Why Workers <em>keep it running.</em></h2>
        </div>
        <div class="cells three">
          {reasons.map(([title, body], i) => (
            <div class="cell">
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          ))}
        </div>
        <p class="command-note">
          This page shows what is happening right now, not a promise. If something is wrong, <a href="https://github.com/dispatch-hq/dispatch/issues" target="_blank" rel="noopener noreferrer">open an issue</a>.
        </p>
      </div>
    </section>

    <section class="final">
      <div class="wrap">
        <h2>Bug reports that <em>don’t go missing.</em></h2>
        <p class="lede">Add Dispatch to your server and connect a repository in a couple of minutes.</p>
        <a class="button large" href="/invite">Add to Discord <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ rounds }}>
    const $ = (id) => document.getElementById(id);
    const set = (id, value) => ($(id).textContent = value);

    // Holds a median. The older key held an average, so it was left behind.
    const BEST_KEY = 'dispatch-best-ping-median';
    const number = new Intl.NumberFormat('en-US');
    const run = $('ping-run');

    const banner = (state, text, note) => {
      $('banner').dataset.state = state;
      set('banner-text', text);
      set('banner-note', note);
    };

    const health = (id, check, up) => {
      const el = $(`${id}-state`);
      el.dataset.ok = String(!!check?.ok);
      el.textContent = check?.ok ? up : 'Unreachable';
    };

    const workerState = (ok) => {
      set('worker-state', ok ? 'Operational' : 'Unreachable');
      $('worker-state').dataset.ok = String(ok);
    };

    // [slower than this many ms stops being the tier, label]
    const tiers = [
      [40, 'Lightning'],
      [90, 'Snappy'],
      [180, 'Steady'],
      [Infinity, 'Scenic route'],
    ];

    // Personal best lives in this browser only; storage can be blocked, so it's optional.
    const readBest = () => {
      try {
        const value = Number(localStorage.getItem(BEST_KEY));
        return value > 0 ? value : null;
      } catch {
        return null;
      }
    };

    const saveBest = (ms) => {
      try {
        localStorage.setItem(BEST_KEY, String(ms));
      } catch {}
    };

    // The vertical axis never covers less than MIN_RANGE_MS, centred on the run, so a
    // steady connection that moves by a millisecond or two draws a calm line rather
    // than a dramatic one. A genuinely jumpy connection still fills the graph.
    const MIN_RANGE_MS = 40;

    function draw(times) {
      const low = Math.min(...times);
      const high = Math.max(...times);
      const range = Math.max(high - low, MIN_RANGE_MS);
      const middle = (low + high) / 2;
      const points = times.map((ms, i) => {
        const x = (i / (rounds - 1)) * 120;
        const y = 28 - ((ms - middle) / range) * 44;
        return `${x.toFixed(1)},${y.toFixed(1)}`;
      });
      $('graph-line').setAttribute('points', points.join(' '));
    }

    // Jitter only ever adds time, so the median describes a connection better than the mean.
    const median = (values) => {
      const sorted = [...values].sort((a, b) => a - b);
      const mid = sorted.length >> 1;
      return Math.round(sorted.length % 2 ? sorted[mid] : (sorted[mid - 1] + sorted[mid]) / 2);
    };

    async function ping() {
      const url = new URL(`/api/ping?t=${Date.now()}`, location.href).href;
      const started = performance.now();
      const res = await fetch(url, { cache: 'no-store' });
      if (!res.ok) throw new Error(String(res.status));
      const body = await res.json();
      const elapsed = performance.now() - started;

      // Resource timing covers just the network (request sent to first byte back), leaving
      // out the page's own JavaScript. Fall back to the stopwatch where it isn't available.
      const entry = performance.getEntriesByName(url, 'resource').pop();
      performance.clearResourceTimings();
      const network = entry && entry.responseStart > entry.requestStart ? entry.responseStart - entry.requestStart : elapsed;
      return { ms: Math.max(1, Math.round(network)), colo: body.colo };
    }

    async function test() {
      run.disabled = true;
      run.textContent = 'Pinging…';
      $('ping-rank').hidden = true;
      $('graph-line').setAttribute('points', '');
      set('ping-note', 'Warming up the connection…');

      const times = [];
      try {
        // The first request pays for the TLS handshake, so it is thrown away.
        await ping();
        let colo = null;
        for (let i = 0; i < rounds; i++) {
          const result = await ping();
          colo = result.colo ?? colo;
          times.push(result.ms);
          draw(times);
          set('ping', String(result.ms));
        }

        const typical = median(times);
        const record = readBest();
        const beat = record === null || typical < record;
        if (beat) saveBest(typical);

        set('ping', String(typical));
        set('ping-rank', tiers.find(([limit]) => typical < limit)[1]);
        $('ping-rank').hidden = false;
        const verdict = record === null ? 'First run, so that is your record.' : beat ? `New personal best, up from ${record} ms!` : `Your best is ${record} ms.`;
        set('ping-note', `Median of ${rounds}. Fastest ${Math.min(...times)} ms, slowest ${Math.max(...times)} ms. ${verdict}`);
        workerState(true);
        if (colo) set('colo', colo);
      } catch {
        set('ping', '—');
        set('ping-note', 'The test failed. Your connection or the Worker is down.');
        workerState(false);
      } finally {
        run.disabled = false;
        run.textContent = 'Go again';
      }
    }

    // Read once on load; the ping test is the only thing that talks to the Worker after that.
    async function status() {
      try {
        const res = await fetch('/api/status', { cache: 'no-store' });
        const body = await res.json();
        health('db', body.checks.database, 'Operational');
        health('discord', body.checks.discord, 'Operational');
        set('db-note', body.checks.database.ms == null ? 'Cloudflare D1 round trip.' : `Cloudflare D1 round trip: ${body.checks.database.ms} ms.`);
        set('discord-note', body.checks.discord.ms == null ? 'Time to read the server list.' : `Reading the server list took ${body.checks.discord.ms} ms.`);
        workerState(true);
        if (body.colo) set('colo', body.colo);
        if (body.servers != null) set('servers', number.format(body.servers));
        if (body.members != null) set('members', number.format(body.members));
        if (body.ok) banner('ok', 'All systems operational', 'The Worker, database and Discord API are all responding.');
        else banner('degraded', 'Something is degraded', 'A dependency isn’t responding. Commands may be slow or fail.');
        set('updated', `Checked ${new Date().toLocaleTimeString()}. Reload to check again.`);
      } catch {
        banner('down', 'Can’t reach Dispatch', 'Your connection or the Worker is down.');
        workerState(false);
        set('updated', 'Reload to try again.');
      }
    }

    run.addEventListener('click', test);
    status();
  </script>
</Base>
