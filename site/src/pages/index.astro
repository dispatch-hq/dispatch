---
import Base from '../layouts/Base.astro';

const steps = [
  {
    title: 'Connect GitHub',
    body: 'An admin runs /dispatch setup, installs the GitHub App and picks the repository. Dispatch checks they have write access.',
  },
  {
    title: 'Collect and review',
    body: 'Members submit structured reports with /report or from any message. Optionally, staff approve them in a triage channel first.',
  },
  {
    title: 'Track through to resolution',
    body: 'Approved reports become GitHub issues, and reporters get updates until the issue is fixed or closed.',
  },
];

const outcomes = [
  {
    title: 'Reports developers can actually use',
    body: 'Members fill in a short form with steps to reproduce and environment, and attach screenshots or logs. Uploads are stored independently of Discord, so the evidence stays available alongside the GitHub issue.',
    points: ['Optional report types become issue labels', 'Right-click any message to report it'],
  },
  {
    title: 'From community feedback to tracked issues',
    body: 'Send reports to a private triage channel where staff approve or reject them with a button, each with its own thread. Approved reports become GitHub issues in the repository you connect.',
    points: ['Triage is optional: skip it and issues are filed immediately', 'Per-member cooldowns keep spam out'],
  },
  {
    title: 'A community that stays involved',
    body: 'Reporters get a DM when their report is approved, answered by a maintainer, or fixed. Hand out roles once a member has enough fixed reports.',
    points: ['/issues shows your open reports in every server, even in DMs', '/stats and /leaderboard keep it friendly'],
  },
];

const trust = [
  {
    title: 'Permissions',
    body: 'Only what the features above need.',
    points: [
      '<b>GitHub App:</b> Issues (read and write), Metadata (read-only). Webhooks for issue, comment and repository events.',
      '<b>Discord:</b> View Channel, Send Messages, Embed Links, Create Public Threads and Manage Roles (for reward roles). No message content access.',
    ],
  },
  {
    title: 'Repository scope',
    body: 'Dispatch touches one repository per server.',
    points: [
      'Each request uses a short-lived GitHub token scoped to the single linked repository.',
      'To link a repo, an admin signs in with GitHub and must have push access to it, so nobody can point reports at a repository they do not control.',
    ],
  },
  {
    title: 'Your data',
    body: 'What is stored, and what is public.',
    points: [
      'Reports (text, reporter Discord ID and username) and server settings are stored in Cloudflare D1.',
      "Attachments are stored in Cloudflare R2 and are public to anyone with the link. Issues include the reporter's Discord username.",
      "Each server's reports are kept separate, and /issues shows a member only their own. Nothing is deleted automatically yet.",
      'Running /dispatch disconnect (or uninstalling the GitHub App) removes the repository link. Existing reports, settings and attachments stay stored.',
    ],
  },
];



const categories = ['Reporting', 'Community', 'Setup', 'Rewards'];

// `admin` commands need the Manage Server permission.
const commands = [
  { name: 'report', icon: '/', category: 'Reporting', key: true, desc: 'Report a bug to the developers. Opens a form with steps, environment and attachments.' },
  { name: 'Apps → Report bug', icon: '↗', category: 'Reporting', menu: true, desc: 'Right-click any message to report it, with its text pre-filled.' },
  { name: 'issues', icon: '/', category: 'Reporting', key: true, desc: 'Your open reports across every server using Dispatch. Works in DMs too.' },
  { name: 'stats', icon: '/', category: 'Community', desc: 'Report counts and reward progress for you or another member.' },
  { name: 'leaderboard', icon: '/', category: 'Community', desc: 'The top bug reporters in this server.' },
  { name: 'dispatch setup', icon: '/', category: 'Setup', admin: true, key: true, desc: 'Connect a GitHub repository to this server.' },
  { name: 'dispatch settings', icon: '/', category: 'Setup', admin: true, key: true, desc: 'Triage queue, updates channel, staff role, labels and cooldown.' },
  { name: 'dispatch disconnect', icon: '/', category: 'Setup', admin: true, desc: 'Unlink the connected repository.' },
  { name: 'dispatch rewards add', icon: '/', category: 'Rewards', admin: true, desc: 'Grant a role once a member has enough fixed bug reports.' },
  { name: 'dispatch rewards remove', icon: '/', category: 'Rewards', admin: true, desc: 'Stop granting a reward role.' },
  { name: 'dispatch rewards list', icon: '/', category: 'Rewards', admin: true, desc: 'Show every reward role and its threshold.' },
];

const keyCommands = commands.filter((c) => c.key).length;
const count = (category: string) => commands.filter((c) => c.category === category).length;

const pipeline = ['Report', 'Triage', 'Issue', 'Fixed', 'Reward'];
// One real report, from a message to a fixed bug. Slides are rebuilt from real screenshots.
const story = [
  { label: 'Report bug', caption: 'Right-click a message, choose Apps → Report bug, and pick the closest type.' },
  { label: 'The form', caption: 'The form opens pre-filled from the message. Add steps and environment.' },
  { label: 'Submitted', caption: 'The reporter gets a private confirmation. Nothing is public yet.' },
  { label: 'Triage', caption: 'Moderators review it in the triage channel, with a thread to discuss.' },
  { label: 'Filed', caption: 'One click approves it, and Dispatch files the GitHub issue.' },
  { label: 'GitHub issue', caption: 'The issue arrives with labels and a link back to the original message.' },
  { label: 'Updates channel', caption: 'When it is fixed, the updates channel announces it and rewards the reporter.' },
  { label: 'Reporter DMs', caption: 'The reporter hears about approval and the fix by DM, so nobody has to ask.' },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <main>
    <div class="hero-bg">
      <div class="wrap hero">
        <div class="hero-copy">
          <span class="tag">Discord → GitHub</span>
          <h1>
            Bug reports from Discord, <em>straight to GitHub.</em>
          </h1>
          <p class="lede">
            Turn community feedback into actionable GitHub issues. Dispatch collects reports, routes them through
            triage if you want it, and keeps reporters updated from submission to fix.
          </p>
          <div class="cta">
            <a class="button large" href="/invite">Add to Discord <span aria-hidden="true">→</span></a>
            <a class="button large ghost" href="#how">How it works</a>
          </div>
          <p class="assure">Access limited to one repository · <a href="#trust">See exactly what it can do</a></p>
        </div>

        <div class="carousel" role="region" aria-roledescription="carousel" aria-label="A bug report, start to finish" tabindex="0">
          <div class="discord">
            <div class="slides">
              <figure class="slide is-active" aria-label="Report bug">
                <div class="slide-body">
                  <div class="d-msg">
                    <img class="d-avatar photo" src="/blackcat.webp" alt="" width="36" height="36" />
                    <div>
                      <div class="d-head"><b>BlackCat</b><time>17:43</time></div>
                      <p>Why does the launcher crash whenever I change this setting?</p>
                    </div>
                  </div>
                  <div class="d-msg">
                    <img class="d-avatar" src="/logo.svg" alt="" width="20" height="22" />
                    <div class="d-main">
                      <div class="d-head"><b>Dispatch</b><span class="d-app">APP</span><time>17:44</time></div>
                      <div class="d-card">
                        <h4>What kind of problem is it?</h4>
                        <p>Pick the closest match. The form opens next.</p>
                        <div class="d-select"><span>Choose a type</span><i aria-hidden="true">⌄</i></div>
                      </div>
                      <small class="d-note">Only you can see this</small>
                    </div>
                  </div>
                </div>
                <figcaption><span>01</span>{story[0].caption}</figcaption>
              </figure>

              <figure class="slide" aria-label="The form">
                <div class="slide-body">
                  <div class="d-modal">
                    <div class="d-modal-head"><img src="/logo.svg" alt="" width="18" height="20" /><b>Report a bug · Crash</b></div>
                    <div class="d-field"><label>Title <em>*</em></label><div class="d-input">Launcher Crash</div></div>
                    <div class="d-field"><label>What happened? <em>*</em></label><div class="d-input">The launcher crashes when I change the resolution</div></div>
                    <div class="d-field"><label>Steps to reproduce</label><div class="d-input">Open settings<br />Try to change the resolution</div></div>
                    <div class="d-field"><label>Version / environment</label><div class="d-input">Windows 11</div></div>
                    <div class="d-actions">
                      <span class="d-btn wide">Cancel</span>
                      <span class="d-btn wide blurple">Submit</span>
                    </div>
                  </div>
                </div>
                <figcaption><span>02</span>{story[1].caption}</figcaption>
              </figure>

              <figure class="slide" aria-label="Submitted">
                <div class="slide-body">
                  <div class="d-msg">
                    <img class="d-avatar" src="/logo.svg" alt="" width="20" height="22" />
                    <div class="d-main">
                      <div class="d-head"><b>Dispatch</b><span class="d-app">APP</span><time>17:46</time></div>
                      <div class="d-card">
                        <h4>Report submitted</h4>
                        <p>Thanks! <b>Launcher Crash</b> is waiting for a moderator to review it. You'll get a DM when it's approved.</p>
                      </div>
                      <small class="d-note">Only you can see this</small>
                    </div>
                  </div>
                </div>
                <figcaption><span>03</span>{story[2].caption}</figcaption>
              </figure>

              <figure class="slide" aria-label="Triage">
                <div class="slide-body">
                  <div class="d-msg">
                    <img class="d-avatar" src="/logo.svg" alt="" width="20" height="22" />
                    <div class="d-main">
                      <div class="d-head"><b>Dispatch</b><span class="d-app">APP</span><time>17:46</time></div>
                      <div class="d-card">
                        <div class="d-row">
                          <h4>Launcher Crash</h4>
                          <span class="d-btn">Source message ↗</span>
                        </div>
                        <small>Report #7 · from <span class="d-mention">@BlackCat</span> · Crash</small>
                        <hr />
                        <p>The launcher crashes when I change the resolution</p>
                        <p><b>Steps to reproduce</b><br />Open settings<br />Try to change the resolution</p>
                        <p><b>Environment</b><br />Windows 11</p>
                        <hr />
                        <p><b>Awaiting review</b></p>
                        <div class="d-actions">
                          <span class="d-btn">Approve</span>
                          <span class="d-btn">Reject</span>
                        </div>
                      </div>
                      <div class="d-card d-thread">
                        <h4>Report #7 · Launcher Crash <span class="d-link">See Thread ›</span></h4>
                        <small>There are no messages in this thread yet.</small>
                      </div>
                    </div>
                  </div>
                </div>
                <figcaption><span>04</span>{story[3].caption}</figcaption>
              </figure>

              <figure class="slide" aria-label="Filed">
                <div class="slide-body">
                  <div class="d-msg">
                    <img class="d-avatar" src="/logo.svg" alt="" width="20" height="22" />
                    <div class="d-main">
                      <div class="d-head"><b>Dispatch</b><span class="d-app">APP</span><time>17:46</time></div>
                      <div class="d-card">
                        <div class="d-row">
                          <h4>Launcher Crash</h4>
                          <span class="d-btn">Source message ↗</span>
                        </div>
                        <small>Report #7 · from <span class="d-mention">@BlackCat</span> · Crash</small>
                        <hr />
                        <p>The launcher crashes when I change the resolution</p>
                        <p><b>Steps to reproduce</b><br />Open settings<br />Try to change the resolution</p>
                        <p><b>Environment</b><br />Windows 11</p>
                        <hr />
                        <div class="d-row stack">
                          <p><b>Filed</b> as <span class="nobr">jakemackie/ReSkateTrainerUpdater#5</span> · approved by <span class="d-mention">@os</span></p>
                          <span class="d-btn">View issue ↗</span>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <figcaption><span>05</span>{story[4].caption}</figcaption>
              </figure>

              <figure class="slide" aria-label="GitHub issue">
                <div class="slide-body">
                  <div class="gh">
                    <h4>Launcher Crash <span>#5</span></h4>
                    <span class="gh-state">Open</span>
                    <div class="gh-box">
                      <div class="gh-bar"><img src="/logo.svg" alt="" width="16" height="18" /><b>dispatch-hq</b><i>bot</i> opened 1m ago</div>
                      <div class="gh-body">
                        <h5>Description</h5>
                        <p>The launcher crashes when I change the resolution</p>
                        <h5>Steps to reproduce</h5>
                        <p>Open settings<br />Try to change the resolution</p>
                        <h5>Environment</h5>
                        <p>Windows 11</p>
                        <hr />
                        <small>Reported from Discord via <u>Dispatch</u> · <u>Original message</u> · Report #7</small>
                      </div>
                    </div>
                    <div class="gh-labels"><b>dispatch-hq</b> added <span class="gh-label bug">bug</span><span class="gh-label crash">Crash</span></div>
                  </div>
                </div>
                <figcaption><span>06</span>{story[5].caption}</figcaption>
              </figure>

              <figure class="slide" aria-label="Updates channel">
                <div class="slide-body">
                  <p class="cmd">in <b>#updates</b></p>
                  <div class="d-card">
                    <p>New bug report from <span class="d-mention">@BlackCat</span>: <b>Launcher Crash</b> → <span class="d-link">jakemackie/ReSkateTrainerUpdater#5</span></p>
                  </div>
                  <div class="d-card">
                    <p>Fixed: <span class="d-link">jakemackie/ReSkateTrainerUpdater#5</span> <b>Launcher Crash</b> — reported by <span class="d-mention">@BlackCat</span></p>
                  </div>
                  <div class="d-card">
                    <p><span class="d-mention">@BlackCat</span> earned <span class="d-mention">@Bug Hunter</span> for <b>1</b> fixed bug reports.</p>
                  </div>
                </div>
                <figcaption><span>07</span>{story[6].caption}</figcaption>
              </figure>

              <figure class="slide" aria-label="Reporter DMs">
                <div class="slide-body">
                  <div class="d-msg">
                    <img class="d-avatar" src="/logo.svg" alt="" width="20" height="22" />
                    <div class="d-main">
                      <div class="d-head"><b>Dispatch</b><span class="d-app">APP</span><time>17:47</time></div>
                      <div class="d-card">
                        <h4>Report approved</h4>
                        <p>Your report <b>Launcher Crash</b> was reviewed and filed as <span class="d-link">jakemackie/ReSkateTrainerUpdater#5</span>. You'll hear from me when it's fixed.</p>
                      </div>
                      <div class="d-card">
                        <h4>Your bug was fixed</h4>
                        <p><span class="d-link">jakemackie/ReSkateTrainerUpdater#5</span> — <b>Launcher Crash</b> was closed as completed. Thanks for reporting it!</p>
                      </div>
                      <div class="d-card">
                        <h4>New reward unlocked</h4>
                        <p>You've had <b>1</b> bug reports fixed and earned a new role. Thank you!</p>
                      </div>
                    </div>
                  </div>
                </div>
                <figcaption><span>08</span>{story[7].caption}</figcaption>
              </figure>
            </div>
          </div>

          <div class="car-controls">
            <button type="button" class="car-btn" data-dir="-1" aria-label="Previous step">←</button>
            <div class="car-dots" role="group" aria-label="Choose step">
              {story.map((step, i) => (
                <button type="button" class:list={['car-dot', { 'is-active': i === 0 }]} data-index={i} aria-label={`Show step ${i + 1}: ${step.label}`}></button>
              ))}
            </div>
            <button type="button" class="car-btn" data-dir="1" aria-label="Next step">→</button>
          </div>
          <p class="assure">A real report, start to finish · from a test server</p>
        </div>
      </div>
    </div>

    <div class="ticker" aria-hidden="true">
      <div class="ticker-track">
        {[0, 1].map(() => (
          <div class="ticker-set">
            {[...pipeline, ...pipeline].map((word) => (
              <span>{word}<i>→</i></span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <section id="how">
      <div class="wrap">
        <div class="section-head">
          <span class="index">01 — How it works</span>
          <h2>Set up in minutes. <em>Let the busywork disappear.</em></h2>
        </div>
        <div class="cells three">
          {steps.map((step, i) => (
            <div class="cell">
              <span class="num">{pad(i + 1)}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="features">
      <div class="wrap">
        <div class="section-head">
          <span class="index">02 — Features</span>
          <h2>More than a bug-report button. <em>The whole feedback loop.</em></h2>
        </div>
        <div class="cells three">
          {outcomes.map((outcome) => (
            <div class="cell">
              <h3>{outcome.title}</h3>
              <p>{outcome.body}</p>
              <ul class="points">
                {outcome.points.map((point) => <li>{point}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="rewards">
      <div class="wrap split">
        <div>
          <span class="index">03 — Rewards</span>
          <h2>Make reporting <em>worth it.</em></h2>
          <p class="lede">
            Give a role once a member has enough reports that were actually fixed. Credit is tied to the issue: close it
            as completed and it counts, reopen it and the credit is taken back.
          </p>
          <p class="assure">Set up with <code>/dispatch rewards add</code></p>
        </div>
        <div class="discord" aria-label="Example reward announcement">
          <p class="cmd">in <b>#updates</b></p>
          <div class="d-card">
            <p><span class="d-mention">@mara</span> earned <span class="d-mention">@Bug Hunter</span> for 3 fixed reports. Thanks for helping squash bugs!</p>
          </div>
          <div class="d-card">
            <h4>Bug reports</h4>
            <small><span class="d-mention">@mara</span></small>
            <p>Next: <span class="d-mention">@Exterminator</span> in <b>2</b> more fixed reports</p>
          </div>
          <p class="assure">Illustrative example · sample names and data</p>
        </div>
      </div>
    </section>

    <section id="trust">
      <div class="wrap">
        <div class="section-head">
          <span class="index">04 — Trust</span>
          <h2>Know what you are <em>connecting.</em></h2>
        </div>
        <div class="cells three">
          {trust.map((item) => (
            <div class="cell">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <ul class="points">
                {item.points.map((point) => <li set:html={point} />)}
              </ul>
            </div>
          ))}
        </div>
        <p class="command-note">
          The source is on <a href="https://github.com/dispatch-hq/dispatch" target="_blank" rel="noopener noreferrer">GitHub</a>. Found a problem with Dispatch itself?{' '}
          <a href="https://github.com/dispatch-hq/dispatch/issues" target="_blank" rel="noopener noreferrer">Open an issue</a>.
        </p>
      </div>
    </section>

    <section id="commands">
      <div class="wrap">
        <div class="section-head">
          <span class="index">05 — Commands</span>
          <h2>Everyday commands. <em>Admin controls when you need them.</em></h2>
        </div>
        <div class="filters" role="group" aria-label="Filter commands">
          <button type="button" class="filter is-active" data-filter="key" aria-pressed="true">
            Key <b>{keyCommands}</b>
          </button>
          <button type="button" class="filter" data-filter="all" aria-pressed="false">
            All <b>{commands.length}</b>
          </button>
          {categories.map((category) => (
            <button type="button" class="filter" data-filter={category} aria-pressed="false">
              {category} <b>{count(category)}</b>
            </button>
          ))}
        </div>
        <div class="command-grid">
          {commands.map((c) => (
            <article class="command-card" data-category={c.category} data-key={c.key ? 'true' : undefined} hidden={!c.key}>
              <div class="command-top">
                <span class="command-icon" aria-hidden="true">{c.icon}</span>
                <h3>{c.name}</h3>
                <span class="command-tags">
                  {c.admin && <span class="chip admin">Admin</span>}
                  <span class={c.menu ? 'chip' : 'chip cat'}>{c.menu ? 'Message menu' : c.category}</span>
                </span>
              </div>
              <p>{c.desc}</p>
            </article>
          ))}
        </div>
        <p class="command-note">Admin commands need the Manage Server permission. “Message menu” items are in a message's Apps menu, not typed.</p>
      </div>
    </section>

    <section class="final">
      <div class="wrap">
        <h2>Ready when <em>you are.</em></h2>
        <p class="lede">Add Dispatch to your server, connect a GitHub repository and start collecting structured bug reports.</p>
        <a class="button large" href="/invite">Add to Discord <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </main>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('.carousel');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('.slide')];
    const dots = [...root.querySelectorAll<HTMLElement>('.car-dot')];
    let current = 0;
    let timer: number | undefined;

    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.classList.toggle('is-active', i === current);
        slide.setAttribute('aria-hidden', String(i !== current));
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === current);
        if (i === current) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const stop = () => window.clearInterval(timer);
    const start = () => {
      stop();
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        timer = window.setInterval(() => show(current + 1), 7000);
      }
    };

    // Any manual interaction ends autoplay for good.
    const go = (index: number) => {
      stop();
      show(index);
    };

    root.querySelectorAll<HTMLElement>('.car-btn').forEach((button) =>
      button.addEventListener('click', () => go(current + Number(button.dataset.dir)))
    );
    dots.forEach((dot) => dot.addEventListener('click', () => go(Number(dot.dataset.index))));
    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') go(current - 1);
      if (event.key === 'ArrowRight') go(current + 1);
    });
    root.addEventListener('pointerenter', stop);

    show(0);
    start();
  }

  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  const cards = [...document.querySelectorAll<HTMLElement>('.command-card')];
  filters.forEach((filter) =>
    filter.addEventListener('click', () => {
      const selected = filter.dataset.filter;
      filters.forEach((f) => {
        const active = f === filter;
        f.classList.toggle('is-active', active);
        f.setAttribute('aria-pressed', String(active));
      });
      cards.forEach((card) => {
        card.hidden =
          selected === 'key' ? card.dataset.key !== 'true' : selected !== 'all' && card.dataset.category !== selected;
      });
    })
  );
</script>
