---
import Base from '../layouts/Base.astro';
---

<!--
  Frame for pages the Worker renders per request (the GitHub sign-in and
  repository picker). The Worker fetches /shell/ and swaps the two placeholders
  below for the page's title and content (see src/web/pages.ts), so these pages
  always share the site's navigation, footer and styles. Not indexed.
-->
<Base title="%%DISPATCH_TITLE%% · Dispatch" noindex>
  <main>%%DISPATCH_CONTENT%%</main>
</Base>

<script>
  // Picker search, on the repository and admin server lists: filters the cards client-side.
  const input = document.querySelector<HTMLInputElement>('[data-repo-search]');
  if (input) {
    const cards = [...document.querySelectorAll<HTMLElement>('[data-repo]')];
    const count = document.querySelector<HTMLElement>('[data-repo-count]');
    const empty = document.querySelector<HTMLElement>('[data-repo-empty]');
    const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-repo-filter]')];
    const total = cards.length;
    let status = 'all';

    const filter = () => {
      const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const card of cards) {
        const haystack = card.dataset.search ?? '';
        const match = terms.every((term) => haystack.includes(term)) && (status === 'all' || card.dataset.status === status || !!card.dataset.tags?.split(' ').includes(status));
        card.hidden = !match;
        if (match) shown++;
      }
      if (count) {
        const noun = total === 1 ? (count.dataset.singular ?? 'repository') : (count.dataset.plural ?? 'repositories');
        count.textContent = shown < total ? `${shown} of ${total} ${noun}` : `${total} ${noun}`;
      }
      if (empty) empty.hidden = shown > 0;
    };

    input.addEventListener('input', filter);
    for (const button of filters) {
      button.addEventListener('click', () => {
        status = button.dataset.repoFilter ?? 'all';
        for (const other of filters) other.setAttribute('aria-pressed', String(other === button));
        filter();
      });
    }
    // "/" jumps to the search box, like on GitHub.
    document.addEventListener('keydown', (event) => {
      const target = event.target as HTMLElement;
      if (event.key === '/' && !/^(INPUT|TEXTAREA)$/.test(target.tagName)) {
        event.preventDefault();
        input.focus();
      }
    });
  }

  // Admin activity: polls for new commands and appends them, like a terminal following a log.
  const POLL_MS = 4000;
  const activity = document.querySelector<HTMLElement>('[data-activity]');

  /** Times arrive in UTC; this shows them in the viewer's own. */
  const localizeTimes = (root: ParentNode) => {
    const today = new Date().toDateString();
    for (const time of root.querySelectorAll<HTMLTimeElement>('time[data-at]')) {
      const at = new Date(Number(time.dataset.at));
      const clock = at.toLocaleTimeString([], { hour12: false });
      time.textContent = at.toDateString() === today ? clock : `${at.toLocaleDateString([], { month: 'short', day: 'numeric' })} ${clock}`;
      time.title = at.toLocaleString();
    }
  };
  localizeTimes(document);

  if (activity) {
    const feed = new URL(activity.dataset.activity!, location.origin);
    const lines = activity.querySelector<HTMLElement>('[data-activity-lines]')!;
    const empty = activity.querySelector<HTMLElement>('[data-activity-empty]');
    const live = document.querySelector<HTMLElement>('[data-activity-live]');
    const liveText = live?.querySelector('b');
    const pause = document.querySelector<HTMLButtonElement>('[data-activity-pause]');
    const older = activity.querySelector<HTMLButtonElement>('[data-activity-older]');
    const total = document.querySelector<HTMLElement>('[data-activity-total]');
    let last = activity.dataset.last ?? '0';
    let first = activity.dataset.first ?? '';
    let paused = false;

    const setState = (state: 'live' | 'paused' | 'offline') => {
      if (live) live.dataset.state = state;
      if (liveText) liveText.textContent = { live: 'Live', paused: 'Paused', offline: 'Reconnecting' }[state];
    };

    const read = async (params: Record<string, string>) => {
      const url = new URL(feed);
      for (const [key, value] of Object.entries(params)) url.searchParams.set(key, value);
      const res = await fetch(url);
      if (!res.ok) throw new Error(String(res.status));
      return (await res.json()) as { html: string; count: number; first: number | null; last: number | null; more: boolean };
    };

    const atBottom = () => activity.scrollHeight - activity.scrollTop - activity.clientHeight < 40;
    activity.scrollTop = activity.scrollHeight;

    const poll = async () => {
      // A hidden tab has nobody to show it to, and each poll is a Worker request.
      if (!paused && !document.hidden) {
        try {
          const result = await read({ after: last });
          if (result.count) {
            const follow = atBottom();
            const holder = document.createElement('div');
            holder.innerHTML = result.html;
            localizeTimes(holder);
            for (const line of holder.querySelectorAll('.log-line')) line.classList.add('fresh');
            lines.append(...holder.childNodes);
            if (empty) empty.hidden = true;
            if (follow) activity.scrollTop = activity.scrollHeight;
            last = String(result.last);
            if (!first) first = String(result.first);
            if (total) total.textContent = (Number(total.textContent!.replace(/\D/g, '')) + result.count).toLocaleString('en-US');
          }
          if (!paused) setState('live');
        } catch {
          setState('offline');
        }
      }
      setTimeout(poll, POLL_MS);
    };
    setTimeout(poll, POLL_MS);

    pause?.addEventListener('click', () => {
      paused = !paused;
      pause.textContent = paused ? 'Resume' : 'Pause';
      pause.setAttribute('aria-pressed', String(paused));
      setState(paused ? 'paused' : 'live');
    });

    older?.addEventListener('click', async () => {
      older.disabled = true;
      try {
        const result = await read({ before: first });
        const height = activity.scrollHeight;
        const holder = document.createElement('div');
        holder.innerHTML = result.html;
        localizeTimes(holder);
        lines.prepend(...holder.childNodes);
        activity.scrollTop += activity.scrollHeight - height;
        if (result.first !== null) first = String(result.first);
        older.hidden = !result.more;
      } catch {
        // Left enabled below, so it can be tried again.
      }
      older.disabled = false;
    });
  }

  // Admin server list: "Create invite" spins while it works, then becomes a "Join server" link.
  const INVITE_ERRORS: Record<string, string> = {
    no_permission: 'No permission to invite',
    gone: 'Bot left this server',
  };

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-invite]');
    if (!button || button.disabled) return;

    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.innerHTML = '<span class="spinner" aria-hidden="true"></span>Creating…';

    let result: { url?: string; error?: string } = {};
    try {
      const res = await fetch(button.dataset.invite!, { method: 'POST' });
      result = await res.json();
    } catch {
      // Falls through to the retry below.
    }
    button.removeAttribute('aria-busy');

    if (result.url) {
      const link = document.createElement('a');
      link.className = 'button small';
      link.href = result.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.innerHTML =
        '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>Join server';
      button.replaceWith(link);
      return;
    }

    const permanent = result.error ? INVITE_ERRORS[result.error] : undefined;
    button.textContent = permanent ?? 'Failed, try again';
    button.disabled = !!permanent;
  });
</script>
