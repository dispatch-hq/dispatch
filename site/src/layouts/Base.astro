---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Path of the page, used for the canonical URL. */
  path?: string;
  /** Keep the page out of search results and skip the social-preview tags. */
  noindex?: boolean;
  /** Path of the 1200×630 social preview image. */
  ogImage?: string;
  imageAlt?: string;
}

const siteName = 'Dispatch';
const {
  title = 'Dispatch — Discord bug reports, straight to GitHub',
  description = 'Dispatch turns /report in Discord into GitHub issues. Triage with a button, keep reporters posted, and reward your best bug hunters with roles.',
  path = Astro.url.pathname,
  noindex = false,
  ogImage = '/og.png',
  imageAlt = 'Dispatch: bug reports from Discord, straight to GitHub.',
} = Astro.props;

const canonical = new URL(path, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: siteName,
  description,
  url: canonical,
  image,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Discord',
  offers: [
    { '@type': 'Offer', name: 'Free', price: '0', priceCurrency: 'USD' },
    { '@type': 'Offer', name: 'Dispatch Pro', price: '1.99', priceCurrency: 'USD' },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <!-- Open Graph. Discord, Slack, iMessage and most link unfurlers read these. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
      </>
    )}

    <!-- Discord uses theme-color as the accent stripe on the embed. -->
    <meta name="theme-color" content="#8497fa" />
    <meta name="color-scheme" content="dark" />

    <!-- HALLOWEEN-START: first-visit ghost flag -->
    <!-- First visit only: flag it before paint, and remember it so the ghost never replays. -->
    <script is:inline>
      try {
        if (!localStorage.getItem('dispatch-ghost-seen')) {
          localStorage.setItem('dispatch-ghost-seen', '1');
          document.documentElement.classList.add('ghost-run');
        }
      } catch (e) {}
    </script>
    <!-- HALLOWEEN-END -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap.xml" />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
  </head>
  <body>
    <!-- HALLOWEEN-START: ghost curtain -->
    <div class="ghost-curtain" aria-hidden="true">
      <div class="ghost">
        <svg viewBox="0 0 200 240" fill="currentColor">
          <defs>
            <mask id="ghost-cut" maskUnits="userSpaceOnUse" x="0" y="0" width="200" height="240">
              <rect width="200" height="240" fill="#fff"></rect>
              <rect x="62" y="68" width="26" height="30" fill="#000"></rect>
              <rect x="112" y="68" width="26" height="30" fill="#000"></rect>
              <rect x="0" y="126" width="200" height="9" fill="#000"></rect>
              <rect x="0" y="156" width="200" height="9" fill="#000"></rect>
              <rect x="0" y="186" width="200" height="9" fill="#000"></rect>
            </mask>
          </defs>
          <path mask="url(#ghost-cut)" d="M20 110A80 80 0 0 1 180 110V222L150 192L125 222L100 192L75 222L50 192L20 222Z"></path>
        </svg>
      </div>
    <!-- HALLOWEEN-END -->
    </div>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="logo" href="/">
          <img src="/logo.svg" alt="" width="22" height="24" />
          <span>Dispatch</span>
        </a>
        <nav class="nav-links" aria-label="Main">
          <button class="nav-trigger" type="button" aria-expanded="false" aria-controls="mega-product">
            Product<svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
          </button>
          <button class="nav-trigger" type="button" aria-expanded="false" aria-controls="mega-resources">
            Resources<svg viewBox="0 0 10 6" width="10" height="6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4"></path></svg>
          </button>
          <a href="/pricing/">Pricing</a>
        </nav>
        <div class="nav-actions">
          <a
            class="nav-icon"
            href="https://github.com/dispatch-hq/dispatch"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Dispatch on GitHub"
          >
            <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
          <a class="button small" href="/invite">Add to Discord</a>
        </div>
        <button
          class="menu-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span></span>
          <span></span>
        </button>
      </div>

      <!-- Desktop dropdown panels. Hidden below 761px, where the mobile menu takes over. -->
      <div class="mega" id="mega-product" hidden>
        <div class="wrap mega-inner">
          <div class="mega-main">
            <p class="mega-label">Product</p>
            <div class="mega-grid">
              <a href="/#how"><i>01</i><b>How it works</b><span>From /report in Discord to a labelled GitHub issue in three steps.</span></a>
              <a href="/#features"><i>02</i><b>Features</b><span>Triage buttons, reporter updates and attachments, kept in sync.</span></a>
              <a href="/#trust"><i>03</i><b>Trust</b><span>Minimal permissions, repository scope and how your data is handled.</span></a>
              <a href="/#commands"><i>04</i><b>Commands</b><span>Every slash command, who can run it and what it does.</span></a>
            </div>
          </div>
          <aside class="mega-spot">
            <p class="mega-label">Spotlight</p>
            <a href="/pricing/">
              <b>Dispatch Pro</b>
              <span>Connect up to 10 repositories to a single server.</span>
              <em>See pricing →</em>
            </a>
          </aside>
        </div>
      </div>

      <div class="mega" id="mega-resources" hidden>
        <div class="wrap mega-inner">
          <div class="mega-main">
            <p class="mega-label">Resources</p>
            <div class="mega-grid">
              <a href="/docs/"><i>01</i><b>Documentation</b><span>Setup, commands and configuration, start to finish.</span></a>
              <a href="https://github.com/dispatch-hq/dispatch" target="_blank" rel="noopener noreferrer"><i>02</i><b>Source on GitHub ↗</b><span>Read the code, follow releases and star the project.</span></a>
              <a href="https://github.com/dispatch-hq/dispatch/issues" target="_blank" rel="noopener noreferrer"><i>03</i><b>Report a problem ↗</b><span>Found a bug in Dispatch itself? Open an issue.</span></a>
              <a href="/status/"><i>04</i><b>Status</b><span>Servers served, live health and how the bot stays online.</span></a>
              <a href="/privacy/"><i>05</i><b>Terms &amp; Privacy</b><span>How Dispatch handles your data, and the rules of use.</span></a>
            </div>
          </div>
          <aside class="mega-spot">
            <p class="mega-label">Spotlight</p>
            <a href="/docs/">
              <b>Get set up in minutes</b>
              <span>Invite the bot, connect a repository and send your first report.</span>
              <em>Read the docs →</em>
            </a>
          </aside>
        </div>
      </div>
    </header>

    <!-- Sits outside the header: its backdrop-filter would otherwise trap a fixed child. -->
    <div class="mobile-menu" id="mobile-menu" hidden>
      <nav class="wrap mobile-menu-inner" aria-label="Mobile">
        <a href="/#how"><i>01</i>How it works</a>
        <a href="/#features"><i>02</i>Features</a>
        <a href="/#trust"><i>03</i>Trust</a>
        <a href="/#commands"><i>04</i>Commands</a>
        <a href="/pricing/"><i>05</i>Pricing</a>
        <a href="/docs/"><i>06</i>Docs</a>
        <a href="/status/"><i>07</i>Status</a>
        <div class="mobile-menu-foot">
          <a class="button large" href="/invite">Add to Discord <span aria-hidden="true">→</span></a>
          <div class="mobile-menu-links">
            <a href="https://github.com/dispatch-hq/dispatch" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
            <a href="/terms/">Terms</a>
            <a href="/privacy/">Privacy</a>
          </div>
        </div>
      </nav>
    </div>

    <slot />

    <footer>
      <div class="wrap">
        <div class="footer-mark">Dispatch<em>.</em></div>
        <div class="footer-cols">
          <div>
            <h4>Product</h4>
            <a href="/#how">How it works</a>
            <a href="/#features">Features</a>
            <a href="/#commands">Commands</a>
            <a href="/pricing/">Pricing</a>
          </div>
          <div>
            <h4>Trust</h4>
            <a href="/#trust">Permissions &amp; data</a>
            <a href="/#trust">Repository scope</a>
          </div>
          <div>
            <h4>Resources</h4>
            <a href="/docs/">Documentation</a>
            <a href="/status/">Status</a>
            <a href="https://github.com/dispatch-hq/dispatch" target="_blank" rel="noopener noreferrer">Source on GitHub</a>
            <a href="https://github.com/dispatch-hq/dispatch/issues" target="_blank" rel="noopener noreferrer">Report a problem</a>
          </div>
          <div>
            <h4>Legal</h4>
            <a href="/terms/">Terms of Service</a>
            <a href="/privacy/">Privacy Policy</a>
          </div>
        </div>
        <div class="footer-row">
          <span>© {new Date().getFullYear()} Dispatch</span>
          <a
            class="github"
            href="https://github.com/dispatch-hq/dispatch"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Dispatch on GitHub"
          >
            <svg viewBox="0 0 16 16" width="20" height="20" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
            </svg>
          </a>
        </div>
      </div>
    </footer>

    <script>
      // HALLOWEEN-START: remove the ghost curtain once it has lifted
      // Drop the entrance once the curtain has lifted (the timeout covers a missed animationend).
      const curtain = document.querySelector('.ghost-curtain');
      if (curtain && document.documentElement.classList.contains('ghost-run')) {
        const done = () => document.documentElement.classList.remove('ghost-run');
        curtain.addEventListener('animationend', (e) => {
          if ((e as AnimationEvent).animationName === 'curtain-lift') done();
        });
        setTimeout(done, 4500);
      }
      // HALLOWEEN-END

      const header = document.querySelector<HTMLElement>('.nav');
      const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.nav-trigger'));
      const hoverable = window.matchMedia('(hover: hover)');

      if (header && triggers.length) {
        let closeTimer: number | undefined;

        const panelOf = (t: HTMLButtonElement) => document.getElementById(t.getAttribute('aria-controls')!)!;

        const show = (active?: HTMLButtonElement) => {
          clearTimeout(closeTimer);
          for (const t of triggers) {
            const on = t === active;
            t.setAttribute('aria-expanded', String(on));
            panelOf(t).hidden = !on;
          }
          header.classList.toggle('has-mega', !!active);
        };

        const scheduleClose = () => {
          clearTimeout(closeTimer);
          closeTimer = window.setTimeout(() => show(), 120);
        };

        for (const t of triggers) {
          t.addEventListener('click', () => show(t.getAttribute('aria-expanded') === 'true' ? undefined : t));
          t.addEventListener('mouseenter', () => hoverable.matches && show(t));
          panelOf(t).addEventListener('click', (e) => {
            if ((e.target as HTMLElement).closest('a')) show();
          });
        }
        header.addEventListener('mouseenter', () => clearTimeout(closeTimer));
        header.addEventListener('mouseleave', () => hoverable.matches && scheduleClose());
        document.addEventListener('click', (e) => {
          if (!header.contains(e.target as Node)) show();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'Escape') return;
          const open = triggers.find((t) => t.getAttribute('aria-expanded') === 'true');
          if (open) {
            show();
            open.focus();
          }
        });
      }

      const toggle =document.querySelector<HTMLButtonElement>('.menu-toggle');
      const menu = document.getElementById('mobile-menu');
      const desktop = window.matchMedia('(min-width: 761px)');

      if (toggle && menu) {
        let hideTimer: number | undefined;

        const setOpen = (open: boolean) => {
          clearTimeout(hideTimer);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          document.documentElement.classList.toggle('menu-open', open);
          if (open) {
            menu.hidden = false;
            // Force a frame so the transition runs from the closed state.
            void menu.offsetWidth;
            menu.classList.add('is-open');
          } else {
            menu.classList.remove('is-open');
            hideTimer = window.setTimeout(() => (menu.hidden = true), 320);
          }
        };

        const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

        toggle.addEventListener('click', () => setOpen(!isOpen()));
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen()) {
            setOpen(false);
            toggle.focus();
          }
        });
        desktop.addEventListener('change', (e) => {
          if (e.matches && isOpen()) setOpen(false);
        });
      }
    </script>
  </body>
</html>
