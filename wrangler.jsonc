{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dispatch",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "DISCORD_PUBLIC_KEY": "d9ba7f51340f9e0aef3ce7224f3ddce364ff9ce12d28521408361ab365fb9a03",
    "DISCORD_APPLICATION_ID": "1530351387320385586"
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  
  // Remote D1 binding. 'database_id' is ignored during 'wrangler dev' (uses local SQLite), 
  // but required by Wrangler schema for remote deployments.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dispatch-db",
      "database_id": "164ae147-457c-4ae2-8aba-d6d2743a284d"
    }
  ]
}